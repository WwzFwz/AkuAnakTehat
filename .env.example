# Reference only: run scripts/secrets/generate.ps1 or generate.sh.
# Each service reads its generated env/<service>.env via Compose.
# Never replace generated secrets with these placeholders.
JWT_ISSUER=bnpb-auth
JWT_AUDIENCE=bnpb-api
ACCESS_TOKEN_TTL=60s
REFRESH_TOKEN_TTL=8h
AGGREGATOR_URL=http://aggregator:9000
AGGREGATOR_TIMEOUT=1500ms
# Linux manual Compose: export LOCAL_UID=$(id -u) LOCAL_GID=$(id -g).
# Make and CI set these automatically; Windows uses the non-root default 10001.

# Relay / consumer non-secret defaults (consumer config can be overridden in Compose).
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=bnpb.hazard-events.v1
KAFKA_DLQ_TOPIC=bnpb.hazard-events.v1.dlq
KAFKA_PUBLISH_TIMEOUT=5s
OUTBOX_POLL_INTERVAL=1s
OUTBOX_RETENTION=24h
PROCESS_TIMEOUT=2s
MAX_ATTEMPTS=3
# KAFKA_GROUP_ID defaults to each consumer service name; do not share groups.
# SQLITE_PATH defaults to /data/view.db or /data/processed.db (notifier).
